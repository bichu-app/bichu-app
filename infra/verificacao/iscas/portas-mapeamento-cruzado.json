{
  "name": "bichu",
  "services": {
    "edge": {
      "environment": {
        "MEDIA_PUBLIC_BASE_URL": "http://localhost:3001",
        "PUBLIC_BASE_URL": "http://localhost:3100"
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 3000,
          "published": "3100",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 3001,
          "published": "3001",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 443,
          "published": "8443",
          "protocol": "tcp"
        }
      ]
    },
    "api": {
      "environment": {
        "API_BASE_URL": "http://localhost:3100",
        "BIND_HOST": "0.0.0.0",
        "MEDIA_PUBLIC_BASE_URL": "http://localhost:3001",
        "PORT": "3000",
        "PUBLIC_BASE_URL": "http://localhost:3100",
        "TAG_BASE_URL": "http://localhost:3100",
        "WEB_BASE_URL": "http://localhost:3100"
      }
    },
    "objeto": {
      "environment": {
        "MINIO_SERVER_URL": "http://localhost:3001"
      }
    }
  }
}
