---
import { REGISTRAR_ACHADO } from '../conteudo/tag.ts';

interface Props {
  /** Na tela 400 a acao principal e procurar o codigo; esta saida fica secundaria. */
  destaque?: boolean;
}
const { destaque = true } = Astro.props;
---
<div class:list={['registrar-achado', destaque ? 'acao' : 'registrar-achado--secundario']}>
  <p class="acao__titulo">{REGISTRAR_ACHADO.titulo}</p>
  <p class="acao__nota">{REGISTRAR_ACHADO.semDestino}</p>
</div>
