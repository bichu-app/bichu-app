---
export const prerender = false;
import Publica from '../../layouts/Publica.astro';
import ProcurarCodigo from '../../componentes/ProcurarCodigo.astro';
import { TAG } from '../../conteudo/tag.ts';

const codigo = (Astro.url.searchParams.get('codigo') ?? '').trim();
if (codigo) {
  return new Response(null, {
    status: 303,
    headers: { Location: `/t/${encodeURIComponent(codigo)}`, 'Cache-Control': 'no-store', 'X-Robots-Tag': 'noindex, nofollow' },
  });
}
Astro.response.status = 400;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<Publica titulo={TAG.tituloDaPagina} descricao={TAG.descricaoDaPagina}>
  <ProcurarCodigo codigo="" />
</Publica>
