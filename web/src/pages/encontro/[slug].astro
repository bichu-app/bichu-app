---
// /encontro/{slug}: a PAGINA PUBLICA DO ENCONTRO -- a nona rota publica do site
// (emenda 4 do ADR-0017, decisao do cliente de 21/10/2026):
//
//   "Criar a pagina do encontro -- mesma forma do pet perdido: pagina publica no
//    site + campo de link no contrato + um interruptor que ACENDE o link sem
//    precisar de APK novo."
//
//   GET -> getNetworkEvent (GET /v1/network/events/{eventSlug})
//
// Renderizada no servidor a cada requisicao (ADR-0028, itens 1 e 2): o HTML ja
// sai com o encontro, e a pagina funciona sem JavaScript. Nenhum script, nenhum
// formulario: esta pagina **so le**.
//
// ====================================================================
// QUEM ABRE ISTO NAO TEM CONTA, E E ISSO QUE FIXA O TETO
// ====================================================================
//
// O link chega por WhatsApp, num grupo de bairro. Entao a pagina obedece ao teto
// da **projecao publica**, e nao ao que o app logado ve:
//
//   - **NAO HA LOGRADOURO.** `street_address` sai so em
//     `getNetworkEventLocation`, com `bearerAuth`, e o ADR-0027 item 21.2 diz
//     que ele nunca sai "na agenda, no detalhe publico, no teaser nem nos
//     detalhes do privado". Esta pagina chama `getNetworkEvent`, que e o detalhe
//     publico: **o campo nao chega aqui**, e se um dia chegar, nao e desenhado.
//     O que sai do lugar sao os quatro rotulos de `NetworkEventPlace` -- nome do
//     lugar, bairro, cidade e UF --, e a pagina DIZ, em uma linha, que o
//     endereco fica no aplicativo.
//   - **NAO HA COORDENADA E NAO HA MAPA.** `NetworkEventPlace` nao tem `lat`,
//     `lon` nem distancia em precisao nenhuma (ADR-0010 itens 4 e 5), e nao ha
//     `<iframe>` de mapa nem link para mapa nesta pagina.
//   - **NAO HA PESSOAS.** Nem quem organiza, nem quem vai, nem contagem: o
//     contrato nao devolve nenhum campo com pessoas (ADR-0025 secao 3), e a
//     `Rede` nao tem lista de presenca (ADR-0025).
//   - **NAO HA IDENTIFICADOR INTERNO.** O endereco desta pagina e o `slug`, que
//     o contrato declara como "o endereco publico do encontro. UUID nao sai
//     nesta secao". Nenhum UUID atravessa (ADR-0010 item 6).
//
// ====================================================================
// SEIS SITUACOES, UMA RESPOSTA
// ====================================================================
//
// Encontro privado, cancelado, encerrado, retirado, em revisao e `slug` que
// nunca existiu leem **a mesma tela**, com o mesmo 410. O porque esta em
// `dominio/telas-do-encontro.ts`, onde a decisao mora e e testada: distinguir
// contaria a um estranho o que a moderacao fez, ou que aquele `slug` existiu --
// a regua do `lost-case-closed`.
export const prerender = false;

import Institucional from '../../layouts/Institucional.astro';
import Estado from '../../componentes/Estado.astro';
import Icone from '../../componentes/Icone.astro';
import Manuscrito from '../../componentes/Manuscrito.astro';
import Ilustracao from '../../componentes/Ilustracao.astro';
import BaixeApp from '../../componentes/BaixeApp.astro';
import { clienteDaApi, executar } from '../../api/chamar.ts';
import type { Resultado } from '../../dominio/resultado.ts';
import {
  telaDoEncontro,
  linhaDoLugar,
  regiaoDoLugar,
  dataLonga,
  faixaDeHorario,
  textoDaEntrada,
  type EncontroDaRede,
  type TelaDoEncontro,
} from '../../dominio/telas-do-encontro.ts';
import { origemDaMidia, fotoPermitida } from '../../dominio/midia.ts';
import { ENCONTRO as T, ROTULOS } from '../../conteudo/encontro.ts';

const slug = Astro.params.slug ?? '';

// `no-store`: o `status` do encontro e CALCULADO no servidor da API a cada
// leitura (`upcoming` -> `happening` -> `ended`), e uma pagina guardada em cache
// continuaria convidando para um encontro que acabou.
Astro.response.headers.set('Cache-Control', 'no-store');

let cliente: string | undefined;
try {
  cliente = Astro.clientAddress;
} catch {
  cliente = undefined;
}
const api = clienteDaApi(Astro.request, cliente);

const resposta = await executar(() =>
  api.GET('/network/events/{eventSlug}', { params: { path: { eventSlug: slug } } }),
);
const tela: TelaDoEncontro = telaDoEncontro(resposta satisfies Resultado<EncontroDaRede>);
Astro.response.status = tela.http;
if (tela.http >= 500) Astro.response.headers.set('Retry-After', '10');

// A capa e as fotos vem da midia publica (img.bichu.app), e so essa origem entra
// na CSP. `fotoPermitida` descarta o que vier de outra origem: a CSP a
// bloquearia, e uma imagem quebrada e pior que nenhuma.
const midia = origemDaMidia(process.env.MEDIA_PUBLIC_BASE_URL);
if (midia) Astro.csp?.insertDirective(`img-src 'self' ${midia}`);

const e = tela.tela === 'encontro' ? tela.encontro : null;

// Os textos derivados. Fora da marcacao de proposito: cada um tem um caso de
// ausencia, e `{a ?? b}` espalhado pelo HTML e onde a ausencia passa calada.
const regiao = e ? regiaoDoLugar(e.place) : '';
const dia = e ? dataLonga(e.starts_at, e.time_zone) : null;
const horario = e ? faixaDeHorario(e.starts_at, e.ends_at, e.time_zone) : null;
const capa = e ? fotoPermitida(e.cover_banner_url ?? e.cover_image_url, midia) : null;
const altDaCapa = e && e.images.length > 0 ? (e.images[0]?.alt_text ?? '') : '';

// Só as fotos ALÉM da capa: repetir a capa na galeria é mostrar a mesma imagem
// duas vezes na mesma rolagem.
const galeria = e
  ? e.images
      .slice(1)
      .map((i) => ({ url: fotoPermitida(i.url, midia), alt: i.alt_text ?? '' }))
      .filter((i): i is { url: string; alt: string } => i.url !== null)
  : [];

const portes = e
  ? e.accepted_sizes.length >= 4
    ? T.todosOsPortes
    : T.portes(e.accepted_sizes.join(', '))
  : '';
const idade = e ? ROTULOS.idade[e.dog_age] : undefined;
const estrutura = e
  ? e.amenities.map((a) => ROTULOS.estrutura[a]).filter((r): r is string => r !== undefined)
  : [];
const levar = e
  ? e.bring_items.map((i) => ROTULOS.levar[i]).filter((r): r is string => r !== undefined)
  : [];

const titulo = e ? T.tituloDaAba(e.title) : T.indisponivel.titulo;
const descricao = e ? T.descricao(e.title, regiao) : T.indisponivel.texto;
---
<Institucional
  titulo={titulo}
  descricao={descricao}
  atual="/comunidade"
  temBaixeApp
  indexar={false}
>
  {/*
    `indexar={false}`: o encontro e EFEMERO. Uma pagina indexada hoje responde
    410 depois do encontro, e o link que o cliente quer que circule e o que a
    pessoa recebe no grupo, nao o que o buscador acha tres meses depois. Ligar a
    indexacao e uma decisao do cliente, e e uma linha aqui.

    O `og:title` e o `og:description` saem do `<Base>` com o TITULO DO ENCONTRO,
    e e esse o ganho medido desta pagina: antes dela, o cartao de
    pre-visualizacao no grupo de WhatsApp dizia "Pagina nao encontrada - Bichu".
  */}

  {e && (
    <article class="encontro">
      <section class="hero hero--pagina" aria-labelledby="encontro-titulo">
        <span class="blob blob--1" aria-hidden="true"></span>
        <div class="hero__texto">
          <p class="secao__sobretitulo sobretitulo">{T.sobretitulo}</p>
          <h1 class="hero__titulo titulo-display" id="encontro-titulo">{e.title}</h1>
          <Manuscrito variante="frase">{T.manuscrito}</Manuscrito>
          <p class="hero__lead">{e.summary}</p>

          <ul class="encontro__resumo">
            {(dia || horario) && (
              <li class="cartao-evento__linha">
                <Icone nome="event" />
                <span>
                  {dia && <strong>{dia}</strong>}
                  {dia && horario && ' · '}
                  {horario}
                </span>
              </li>
            )}
            <li class="cartao-evento__linha">
              <Icone nome="location_on" />
              <span>{linhaDoLugar(e.place)}</span>
            </li>
            <li class="cartao-evento__linha">
              <Icone nome="info" />
              <span>{textoDaEntrada(e.admission)}</span>
            </li>
          </ul>

          {/*
            A frase que explica a AUSENCIA do endereco. Ela existe para que a
            falta nao pareca defeito: sem ela, quem abre a pagina procura o
            endereco, nao acha, e toca de novo.
          */}
          <p class="nota-exemplo">{T.semEndereco}</p>

          {e.ticket_url && (
            <p class="encontro__acoes">
              <a class="botao botao--primario" href={e.ticket_url} rel="nofollow noopener">
                {T.convite}
              </a>
            </p>
          )}
        </div>

        <div class="hero__ilustracao">
          {capa ? (
            <img
              class="recorte recorte--encontro"
              src={capa}
              alt={altDaCapa}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            /*
              Sem capa a pagina NAO fica sem imagem: a ilustracao da folha entra
              no lugar -- a MESMA de `/comunidade`, pelo mesmo componente. Um
              encontro sem foto e comum (quem cadastra pela comunidade costuma
              nao ter uma), e um bloco vazio aqui tiraria da pagina exatamente o
              que faz alguem querer ir.

              `alt=""`: ela e decorativa e redundante com o titulo ao lado.
            */
            <Ilustracao recorte="encontro" alt="" principal />
          )}
        </div>
      </section>

      <span class="divisor-onda" aria-hidden="true"></span>

      <section class="secao" aria-labelledby="quem-titulo">
        <div class="secao__cabecalho">
          <h2 class="titulo-secao" id="quem-titulo">{T.quemPodeIr}</h2>
        </div>
        <ul class="lista-marcada">
          <li><Icone nome="pets" /> {portes}</li>
          {idade && <li><Icone nome="pets" /> {idade}</li>}
          {e.vaccination_required && <li><Icone nome="check_circle" /> {T.vacinaExigida}</li>}
          <li>
            <Icone nome={e.fenced_off_leash_area ? 'check_circle' : 'info'} />
            {e.fenced_off_leash_area ? T.areaCercada : T.semAreaCercada}
          </li>
        </ul>
      </section>

      {estrutura.length > 0 && (
        <section class="secao" aria-labelledby="estrutura-titulo">
          <div class="secao__cabecalho">
            <h2 class="titulo-secao" id="estrutura-titulo">{T.estrutura}</h2>
          </div>
          <ul class="lista-marcada">
            {estrutura.map((r) => <li><Icone nome="park" /> {r}</li>)}
          </ul>
        </section>
      )}

      {levar.length > 0 && (
        <section class="secao" aria-labelledby="levar-titulo">
          <div class="secao__cabecalho">
            <h2 class="titulo-secao" id="levar-titulo">{T.oQueLevar}</h2>
          </div>
          <ul class="lista-marcada">
            {levar.map((r) => <li><Icone nome="check_circle" /> {r}</li>)}
          </ul>
        </section>
      )}

      <section class="secao garantias" aria-labelledby="cuidados-titulo">
        <div class="secao__cabecalho">
          <h2 class="titulo-secao" id="cuidados-titulo">{T.cuidados}</h2>
        </div>
        <ul class="lista-marcada">
          {T.cuidadosLista(e.fenced_off_leash_area).map((f) => (
            <li><Icone nome="info" /> {f}</li>
          ))}
        </ul>
      </section>

      {e.notes && (
        <section class="secao" aria-labelledby="obs-titulo">
          <div class="secao__cabecalho">
            <h2 class="titulo-secao" id="obs-titulo">{T.observacoes}</h2>
          </div>
          {/*
            Texto de quem organiza. Sai como TEXTO e nunca como marcacao: o
            Astro escapa por padrao, e nao ha `set:html` nesta pagina.
          */}
          <p class="texto-grande">{e.notes}</p>
        </section>
      )}

      {galeria.length > 0 && (
        <section class="secao" aria-labelledby="fotos-titulo">
          <div class="secao__cabecalho">
            <h2 class="titulo-secao" id="fotos-titulo">{T.fotos}</h2>
          </div>
          <ul class="grade-posts" aria-label={T.fotos}>
            {galeria.map((f) => (
              <li><img src={f.url} alt={f.alt} loading="lazy" /></li>
            ))}
          </ul>
        </section>
      )}

      {e.instagram_url && (
        <p class="encontro__acoes">
          <a class="botao botao--secundario" href={e.instagram_url} rel="nofollow noopener">
            {T.instagram}
          </a>
        </p>
      )}

      {/* O segundo trabalho da pagina: o caminho para o aplicativo. */}
      <BaixeApp titulo={T.chamada.titulo} texto={T.chamada.texto} />
    </article>
  )}

  {tela.tela === 'indisponivel' && (
    <Estado icone="link_off" titulo={T.indisponivel.titulo} tom="alerta">
      <p>{T.indisponivel.texto}</p>
      <p class="encontro__acoes">
        <a class="botao botao--primario" href={T.indisponivel.acaoHref}>
          {T.indisponivel.acao}
        </a>
      </p>
    </Estado>
  )}

  {tela.tela === 'espere' && (
    <Estado icone="hourglass" titulo={T.espere.titulo} tom="alerta">
      <p>{T.espere.texto}</p>
    </Estado>
  )}

  {tela.tela === 'fora-do-ar' && (
    <Estado icone="wifi_off" titulo={T.foraDoAr.titulo} tom="alerta">
      <p>{T.foraDoAr.texto}</p>
    </Estado>
  )}

  {tela.tela === 'erro' && (
    <Estado icone="error" titulo={T.erro.titulo} tom="alerta">
      <p>{T.erro.texto}</p>
      {tela.correlationId && <p class="nota-exemplo">{tela.correlationId}</p>}
    </Estado>
  )}
</Institucional>
