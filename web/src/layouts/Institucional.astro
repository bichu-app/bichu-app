---
import Base from './Base.astro';
import Cabecalho from '../componentes/Cabecalho.astro';
import Rodape from '../componentes/Rodape.astro';
import { getImage } from 'astro:assets';
import imagemPrevia from '../assets/ilustracoes/ilustracao-tres-pessoas.png';
import { NAVEGACAO } from '../conteudo/comum.ts';
import '../styles/institucional.css';

interface Props {
  titulo: string;
  descricao: string;
  atual: string;
  temBaixeApp?: boolean;
  /** Termos e Privacidade sobem com noindex ate o texto juridico final. */
  indexar?: boolean;
}
const { titulo, descricao, atual, temBaixeApp = false, indexar = true } = Astro.props;
const previa = await getImage({ src: imagemPrevia, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
---
<Base
  titulo={titulo}
  descricao={descricao}
  indexar={indexar}
  imagemOg={{ src: previa.src, largura: 1200, altura: 630, alt: 'Ilustração de três pessoas abraçadas a um cachorro e a um gato.' }}
>
  <a class="pular-para-conteudo" href="#conteudo">{NAVEGACAO.pular}</a>
  <Cabecalho atual={atual} temBaixeApp={temBaixeApp} />
  <main id="conteudo">
    <slot />
  </main>
  <Rodape />
</Base>
