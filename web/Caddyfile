# Servidor ESTATICO do site (institucional e paginas publicas). Roda dentro do
# container `web`, atras da borda (`infra/caddy/Caddyfile`), e nao fala com o
# mundo direto: nao publica porta, nao emite certificado, nao conhece dominio.
#
# Quem decide QUAL host chega aqui e a borda. Este arquivo so decide COMO os
# bytes saem. Separar as duas coisas e o que deixa o site mudar de maquina (ou
# ir para armazenamento de objeto com CDN na frente) trocando uma linha na
# borda, sem tocar nesta imagem.
{
	# Sem API de administracao: a configuracao nasce com a imagem e so muda com
	# imagem nova. Nada para recarregar por fora, nada escutando alem da 8080.
	admin off
	# Sem certificado, sem redirecionamento para HTTPS: TLS termina na borda.
	auto_https off
	persist_config off
}

:8080 {
	root * /srv/site

	# Cache em duas classes, e a divisao e por NOME DE ARQUIVO, nao por gosto:
	#
	#   - o que o build nomeia com hash (`/_astro/*` no Astro) nunca muda de
	#     conteudo sem mudar de nome, entao pode ficar um ano no navegador;
	#   - o resto (HTML, e o que mora em `public/` sem hash) precisa ser
	#     revalidado a cada visita, senao uma correcao publicada fica invisivel
	#     ate o cache de alguem expirar.
	#
	# Se o site deixar de ser Astro, o caminho do primeiro matcher muda junto.
	@comhash path /_astro/*
	header @comhash Cache-Control "public, max-age=31536000, immutable"
	@semhash not path /_astro/*
	header @semhash Cache-Control "no-cache"

	header {
		-Server
		X-Content-Type-Options nosniff
	}

	# Pre-compressao feita no build, quando existir (`.br`/`.gz` ao lado do
	# arquivo); sem ela, comprime na hora. A borda tambem comprime, mas so o
	# que chega sem `Content-Encoding`.
	file_server {
		precompressed br gzip
	}
	encode zstd gzip

	# Sem `try_files` para um `index.html` generico, de proposito: pagina que
	# nao existe responde 404 de verdade, e nao a home com 200. Rota dinamica
	# (`/t/{code}` e parecidas) e decisao de quem desenha o site, e precisa
	# entrar aqui com o caminho dela escrito, nao como fallback que engole tudo.
	#
	# O erro sai com `no-store`, sobrescrevendo a classe de cache acima: sem
	# isto, um 404 em `/_astro/*` (arquivo de um deploy anterior, por exemplo)
	# ficaria guardado como imutavel por um ano no navegador de quem o pediu.
	handle_errors {
		header Cache-Control "no-store"
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}
