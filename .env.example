# .env.example - Bichu. Versionado, SEMPRE com valor vazio ou de desenvolvimento.
# Copie para `.env` e preencha. O `.env` nunca entra no git (ver .gitignore).
#
# Regra de nome: nenhuma variavel carrega marca de provedor. `OBJECT_STORAGE_*`
# e nao `AWS_*`, porque o codigo fala com a API S3 e nao com um fornecedor.

ENVIRONMENT=dev

# --- URLs base. Tres, e o motivo de serem tres esta em docs/07-devops.md 3.9 --
# PUBLIC_BASE_URL: o que o QR codifica, o cartaz, o link do caso, os links dos
#   e-mails e o destino do deep link. E o que um estranho abre.
# MEDIA_PUBLIC_BASE_URL: origem das derivadas publicas. Separada por exigencia
#   do ADR-0007: midia de usuario nunca na origem da aplicacao.
# API_BASE_URL: o que o app Flutter chama. Resolvida no build do app, nao no
#   runtime do servidor, e legitimamente diferente das outras no mesmo ambiente.
#
# Para alcancar um segundo aparelho na mesma Wi-Fi: `make up HOST=192.168.0.10`.
PUBLIC_BASE_URL=http://localhost:3000
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000
MINIO_CONSOLE_URL=http://localhost:9001

# --- Banco ---
POSTGRES_USER=bichu
POSTGRES_PASSWORD=
POSTGRES_DB=bichu
DATABASE_URL=postgres://bichu:@db:5432/bichu

# --- Armazenamento de objeto (API S3) ---
OBJECT_STORAGE_ENDPOINT=http://objeto:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_BUCKET_PRIVATE=bichu-media-private
OBJECT_BUCKET_PUBLIC=bichu-media-public

# --- E-mail ---
# MAIL_FROM precisa ser EXATAMENTE em @mail.bichu.app. O DMARC do apex esta em
# p=reject com adkim=s: um remetente em @bichu.app quebra o alinhamento estrito
# e o e-mail e descartado. Uma palavra errada aqui derruba o cadastro inteiro
# sem uma linha de erro. Ver docs/07-devops.md 16.6.
MAIL_TRANSPORT=smtp
MAIL_FROM=avisos@mail.bichu.app
MAIL_FROM_NAME=Bichu
# mail.bichu.app envia e nao recebe (sem MX). Resposta vai para a caixa real.
MAIL_REPLY_TO=oi@bichu.app
MAIL_API_TOKEN=

# --- Push ---
# `log` grava o payload e os destinatarios: prova a consulta de 5 km, o teto de
# 500 e o de fadiga, sem FCM. Nao prova que o telefone vibra.
PUSH_TRANSPORT=log
FCM_SERVICE_ACCOUNT_JSON=

# --- Chaves ---
# Chave de 256 bits que cifra o codigo da tag. A de homologacao precisa ser
# DIFERENTE da de desenvolvimento, e nenhuma das duas entra no repositorio.
KMS_TRANSPORT=local
TAG_CODE_KEY=

# --- Observabilidade ---
# Vazio DESLIGA o envio sem quebrar a aplicacao. Deliberado: o produto nao pode
# depender do Sentry para subir. O piso e o log estruturado, nao o complemento.
SENTRY_DSN=

# --- Worker ---
# Uma imagem por vez. Ver o bloco de memoria no topo do compose.yaml.
WORKER_IMAGE_CONCURRENCY=1

# --- Desafio antiautomacao (paginas web) ---
# Segue a convencao de MAIL_TRANSPORT / PUSH_TRANSPORT / KMS_TRANSPORT.
# NAO se aplica ao app: la a ferramenta e atestacao (Firebase App Check).
# NAO se aplica a rota do achador: decisao registrada em docs/04-seguranca.md 4.9,
# e a politica de conteudo daquela pagina proibe script de terceiro.
# Onde entra: pedido de redefinicao de senha, reenvio de verificacao, cadastro e
# login - as paginas web que disparam ENVIO PAGO de e-mail.
# CAPTCHA_SITE_KEY e publica: aparece no HTML. A secreta nunca sai do servidor.
CAPTCHA_TRANSPORT=recaptcha_enterprise
# Enterprise NAO tem chave secreta: o servidor autentica com conta de servico do
# projeto e chama a API de avaliacao. A chave abaixo e publica (vai no HTML).
CAPTCHA_SITE_KEY=CMEtAAAAAB1j0t8oD112-ML_Jqqiqc0mHwqi
CAPTCHA_PROJECT=bichu-app-508914
CAPTCHA_MIN_SCORE=0.5
