# .env.example - Bichu. Versionado, SEMPRE com valor vazio ou de desenvolvimento.
# Copie para `.env` e preencha. O `.env` nunca entra no git (ver .gitignore).
#
# Regra de nome: nenhuma variavel carrega marca de provedor. `OBJECT_STORAGE_*`
# e nao `AWS_*`, porque o codigo fala com a API S3 e nao com um fornecedor.

ENVIRONMENT=dev

# --- URLs base. Tres, e o motivo de serem tres esta em docs/07-devops.md 3.9 --
# PUBLIC_BASE_URL: o que o QR codifica, o cartaz, o link do caso, os links dos
#   e-mails e o destino do deep link. E o que um estranho abre.
# MEDIA_PUBLIC_BASE_URL: origem das derivadas publicas. Separada por exigencia
#   do ADR-0007: midia de usuario nunca na origem da aplicacao.
# API_BASE_URL: o que o app Flutter chama. Resolvida no build do app, nao no
#   runtime do servidor, e legitimamente diferente das outras no mesmo ambiente.
#
# Para alcancar um segundo aparelho na mesma Wi-Fi: `make up HOST=192.168.0.10`.
PUBLIC_BASE_URL=http://localhost:3000
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000
MINIO_CONSOLE_URL=http://localhost:9001

# --- Banco ---
POSTGRES_USER=bichu
POSTGRES_PASSWORD=
POSTGRES_DB=bichu
DATABASE_URL=postgres://bichu:@db:5432/bichu
# Teto de conexoes por instancia. Baixo de proposito: a instancia do MVP divide
# 2 GB com o Postgres, e pool grande transforma pico de trafego em falta de
# memoria no banco, que e o processo que o sistema mata primeiro (ADR-0013).
DATABASE_POOL_MAX=10

# --- Armazenamento de objeto (API S3) ---
OBJECT_STORAGE_ENDPOINT=http://objeto:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_BUCKET_PRIVATE=bichu-media-private
OBJECT_BUCKET_PUBLIC=bichu-media-public
# Chave do KMS embutido do MinIO, no formato `nome:base64-de-32-bytes`.
# Sem ela o armazenamento responde 501 ao envio, porque a politica assinada
# exige criptografia no servidor (BICHUS-87, criterio 22).
# Gere com: printf 'bichu-dev:%s' "$(openssl rand -base64 32)"
OBJECT_STORAGE_KMS_KEY=

# --- E-mail ---
# MAIL_FROM precisa ser EXATAMENTE em @mail.bichu.app. O DMARC do apex esta em
# p=reject com adkim=s: um remetente em @bichu.app quebra o alinhamento estrito
# e o e-mail e descartado. Uma palavra errada aqui derruba o cadastro inteiro
# sem uma linha de erro. Ver docs/07-devops.md 16.6.
MAIL_TRANSPORT=smtp
# Host e porta do receptor. No compose e o `mail` (mailpit) na 1025.
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_FROM=avisos@mail.bichu.app
MAIL_FROM_NAME=Bichu
# mail.bichu.app envia e nao recebe (sem MX). Resposta vai para a caixa real.
MAIL_REPLY_TO=oi@bichu.app
MAIL_API_TOKEN=

# --- Push ---
# `log` grava o payload e os destinatarios: prova a consulta de 5 km, o teto de
# 500 e o de fadiga, sem FCM. Nao prova que o telefone vibra.
PUSH_TRANSPORT=log

# FCM_SERVICE_ACCOUNT_JSON FICA VAZIA, inclusive em producao. Nao e pendencia.
# A organizacao recusa emitir chave baixavel (constraints/iam.disableServiceAccountKeyCreation)
# e a recusa esta certa: chave de conta de servico e um segredo de longa vida que
# nao expira, nao se revoga sozinho e viaja em anexo de e-mail.
# O credencial vem da conta anexada a maquina, lida do metadata server em runtime:
#   conta: bichu-push@bichu-app-508914.iam.gserviceaccount.com
#   papel: projects/bichu-app-508914/roles/bichu.pushSender
#   permissao, unica: cloudmessaging.messages.create
# Ou seja: essa identidade envia push e NADA mais. Nao le Firestore, nao mexe em
# Auth, nao toca Storage, nao assina topico. Se vazar, o estrago maximo e push.
# A variavel existe so como saida de emergencia se um dia rodarmos fora do GCP.
FCM_SERVICE_ACCOUNT_JSON=

# --- Chaves ---
# Chave de 256 bits que cifra o codigo da tag. A de homologacao precisa ser
# DIFERENTE da de desenvolvimento, e nenhuma das duas entra no repositorio.
KMS_TRANSPORT=local
TAG_CODE_KEY=

# --- Token de acesso e assinatura (ADR-0002) ---
# RS256, sempre. HS256 fecharia a porta do Keycloak e a aplicacao recusa subir
# com chave que nao seja RSA.
#
# Sao DUAS chaves desde o inicio: a ativa assina, a de rotacao ja e publicada no
# JWKS. Publicar so a ativa impede rotacionar sem derrubar sessao, porque quem
# valida precisa conhecer a proxima antes de ela comecar a assinar.
#
# Gere cada uma com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# A variavel aceita o PEM cru OU o PEM em base64 (`base64 -w0 chave.pem`), e a
# segunda forma existe porque quebra de linha dentro de .env e a causa mais
# comum de chave que "sumiu" na subida.
#
# O `kid` NAO e segredo: ele vai no cabecalho do JWT e no JWKS. So precisa ser
# diferente entre as duas, senao o consumidor escolhe a errada e a assinatura
# falha.
JWT_ACTIVE_KID=dev-ativa
JWT_ACTIVE_PRIVATE_KEY=
# A de rotacao e opcional SO em desenvolvimento. Com ENVIRONMENT=prod ou
# preprod, ou com NODE_ENV=production, a aplicacao RECUSA SUBIR sem as duas,
# nomeando a que faltou -- isto aqui deixou de ser recomendacao e virou guarda
# (BICHUS-124).
#
# O motivo: o contrato promete "Sempre duas chaves" em /.well-known/jwks.json, e
# quem consome esse arquivo nao e este servico, e sim terceiro, que cacheia. Sem
# a de rotacao ja publicada, rotacionar derruba toda sessao valida -- e a falta
# dela so apareceria no dia da rotacao, que e tarde demais.
JWT_NEXT_KID=dev-rotacao
JWT_NEXT_PRIVATE_KEY=

# Emissor do token. Vazio derruba a aplicacao na subida, de proposito.
TOKEN_ISSUER=http://localhost:3000
# Vazio = igual ao emissor, que e o que se quer enquanto houver um emissor so.
TOKEN_AUDIENCE=
# Lista separada por virgula, e nao um emissor fixo: e o que permite dois
# emissores coexistirem durante a virada para o Keycloak. Vazio = so o emissor
# acima. O proprio TOKEN_ISSUER e sempre aceito, esteja ou nao na lista.
TOKEN_TRUSTED_ISSUERS=

# Chave do HMAC de endereco IP (SEC-010). Ao menos 32 bytes em base64, e a
# aplicacao confere o tamanho na subida: hash de IP sem chave secreta e o IP em
# claro com um passo a mais -- o espaco do IPv4 inteiro quebra em minutos.
#   openssl rand -base64 32
IP_HMAC_KEY=

# --- Observabilidade ---
# Vazio DESLIGA o envio sem quebrar a aplicacao. Deliberado: o produto nao pode
# depender do Sentry para subir. O piso e o log estruturado, nao o complemento.
SENTRY_DSN=

# --- Worker ---
# Uma imagem por vez. Ver o bloco de memoria no topo do compose.yaml.
WORKER_IMAGE_CONCURRENCY=1

# --- Desafio antiautomacao (paginas web) ---
# Segue a convencao de MAIL_TRANSPORT / PUSH_TRANSPORT / KMS_TRANSPORT.
# NAO se aplica ao app: la a ferramenta e atestacao (Firebase App Check).
# NAO se aplica a rota do achador: decisao registrada em docs/04-seguranca.md 4.9,
# e a politica de conteudo daquela pagina proibe script de terceiro.
# Onde entra: pedido de redefinicao de senha, reenvio de verificacao, cadastro e
# login - as paginas web que disparam ENVIO PAGO de e-mail.
# CAPTCHA_SITE_KEY e publica: aparece no HTML. A secreta nunca sai do servidor.
CAPTCHA_TRANSPORT=recaptcha_enterprise
# Enterprise NAO tem chave secreta: o servidor autentica com conta de servico do
# projeto e chama a API de avaliacao. A chave abaixo e publica (vai no HTML).
CAPTCHA_SITE_KEY=
CAPTCHA_PROJECT=bichu-app-508914
CAPTCHA_MIN_SCORE=0.5

# --- Contrato ---
# Onde o servidor le a especificacao em runtime: os tetos de chamada e os
# `security` saem DALI, nao de uma copia no codigo. Relativo ao diretorio de
# trabalho do processo.
OPENAPI_SPEC_PATH=api/openapi.yaml

# Gerenciador de segredos (ADR-0022). SO e lido em prod/preprod: em `dev` e em
# teste os segredos continuam vindo deste arquivo, e exigir uma nuvem para rodar
# `npm test` seria atrito novo sem risco atras dele.
#
# O nome do segredo no gerenciador e IGUAL ao nome da variavel, sem tabela de
# traducao. O que muda entre homologacao e producao e o PROJETO apontado aqui --
# e por isso que nao existe `MAIL_API_TOKEN_HML`.
SECRET_STORE_PROJECT=
SECRET_STORE_VERSION=
