<?xml version="1.0" encoding="utf-8"?>
<!--
    CAMADA DE PRIMEIRO PLANO DO ICONE ADAPTATIVO. VAZIA DE PROPOSITO.

    Aqui vai o SIMBOLO da marca, e ele e entrega da designer
    (`design/marca/app/icone-android-foreground.png`). Enquanto nao chega, esta
    camada e transparente.

    POR QUE TRANSPARENTE E NAO UM DESENHO QUALQUER: qualquer forma que eu
    colocasse aqui seria eu inventando a marca do cliente. Um vazio declarado e
    honesto: ate a arte chegar o icone aparece como um quadrado Framboesa
    liso, que e obviamente provisorio. Um desenho improvisado pareceria pronto.

    Existe pelo mesmo motivo do fundo: `mipmap-anydpi-v26/ic_launcher.xml`
    referencia esta camada e referencia que nao resolve quebra o build.

    SAI QUANDO A ARTE CHEGAR, junto com `ic_launcher_background.xml`.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
