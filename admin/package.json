{
  "name": "bichu-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Backoffice do Bichu (admin.bichu.app): SPA estatica que consome /v1/admin.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "generate:tokens": "node scripts/gerar-tokens-css.mjs",
    "verify:tokens": "node scripts/gerar-tokens-css.mjs --verificar",
    "generate:api": "node scripts/gerar-tipos-da-api.mjs",
    "verify:api": "node scripts/gerar-tipos-da-api.mjs --verificar"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
